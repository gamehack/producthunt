# Local manual execution only. Production credentials belong in GitHub Actions secrets.
# The daily production workflow is .github/workflows/daily.yml.

# Product Hunt official API
PRODUCT_HUNT_TOKEN=
PRODUCT_HUNT_COMMERCIAL_AUTHORIZED=false

# OmniRoute must be reachable from GitHub-hosted runners over HTTPS.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=minimax-m3

# Keep disabled by default for local development; production workflow sets both to true.
NOTION_ENABLE_SYNC=false
NOTION_AUTOSYNC_AFTER_GENERATION=false
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=4109e605-ccf8-81c4-accd-c19386b4a38d

# Per-run working data. GitHub Actions caches checkpoints by Product Hunt snapshot date.
PRODUCTHUNT_SOURCE=producthunt
PRODUCTHUNT_DB_PATH=data/producthunt.sqlite
PRODUCTHUNT_OUTPUT_DIR=output
PRODUCTHUNT_OPPORTUNITY_THRESHOLD=60
PRODUCTHUNT_MAX_RESEARCH=5
