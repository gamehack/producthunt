# Product Hunt official API. Commercial authorization must be explicit.
PRODUCT_HUNT_TOKEN=
PRODUCT_HUNT_COMMERCIAL_AUTHORIZED=false

# Existing OmniRoute OpenAI-compatible endpoint.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=minimax-m3

# Mandatory Notion 08 READY delivery.
NOTION_ENABLE_SYNC=false
NOTION_AUTOSYNC_AFTER_GENERATION=false
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=4109e605-ccf8-81c4-accd-c19386b4a38d

# Local state. Do not reuse old qjai-intelligence SQLite checkpoints.
PRODUCTHUNT_DB_PATH=data/producthunt.sqlite
PRODUCTHUNT_OUTPUT_DIR=output
PRODUCTHUNT_OPPORTUNITY_THRESHOLD=60
PRODUCTHUNT_MAX_RESEARCH=5

# Optional explicit Docker network attached to the OmniRoute container.
PRODUCTHUNT_OMNIROUTE_NETWORK=
